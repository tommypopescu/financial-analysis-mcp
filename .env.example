# Financial Analysis MCP Server Configuration
# Copy this file to .env and adjust values as needed

# ============================================
# Server Configuration
# ============================================
MCP_SERVER_PORT=3000
LOG_LEVEL=INFO

# ============================================
# Data Configuration
# ============================================
# Path to ticker CSV file (relative to container or absolute)
TICKER_CSV_PATH=/app/data/tickers.csv

# Cache settings for market data
CACHE_ENABLED=true
CACHE_TTL=300

# ============================================
# Market Data Defaults
# ============================================
# Default period for historical data
# Valid values: 1d, 5d, 1mo, 3mo, 6mo, 1y, 2y, 5y, 10y, ytd, max
DEFAULT_PERIOD=1y

# Default interval for data points
# Valid values: 1m, 2m, 5m, 15m, 30m, 60m, 90m, 1h, 1d, 5d, 1wk, 1mo, 3mo
DEFAULT_INTERVAL=1d

# ============================================
# Technical Indicators Parameters
# ============================================
# RSI (Relative Strength Index)
RSI_WINDOW=14

# MACD (Moving Average Convergence Divergence)
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# ADX (Average Directional Index)
ADX_PERIOD=14

# ============================================
# Analysis Configuration
# ============================================
# Number of months to analyze for investment summary
ANALYSIS_MONTHS=6